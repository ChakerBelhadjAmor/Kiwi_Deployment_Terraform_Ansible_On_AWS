#!/bin/sh
# Points {{ vault_duckdns_subdomain }}.duckdns.org at this host's Elastic IP.
set -eu
. /etc/duckdns.env
result=$(curl -fsS "https://www.duckdns.org/update?domains=${DUCKDNS_SUBDOMAIN}&token=${DUCKDNS_TOKEN}&ip={{ ansible_host }}")
[ "$result" = "OK" ] || { echo "DuckDNS update failed" >&2; exit 1; }
